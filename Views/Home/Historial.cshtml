@model SmartProcessAI.ViewModels.HistorialViewModel
@using SmartProcessAI.ViewModels
@{
    ViewData["Title"] = "Historial y seguimiento";
    ViewData["Activo"] = "historial";
}

<div class="cabecera">
    <div>
        <h1>Historial y seguimiento</h1>
        <p>Decisiones tomadas sobre cada hallazgo</p>
    </div>
    <a class="boton boton-oscuro" href="#">Exportar reporte</a>
</div>

<div class="tarjeta">
    @if (Model.Decisiones.Count == 0)
    {
        <p class="mb-0">Todavía no se ha decidido ningún hallazgo.</p>
    }
    else
    {
        <div class="linea-tiempo">
            @foreach (var d in Model.Decisiones)
            {
                bool aprobada = d.EstadoRevision == "Aprobada";
                <div class="evento">
                    <span class="evento-punto" style="--punto:@(aprobada ? "#2F7D5B" : "#C0392B")"></span>
                    <div class="evento-cuerpo">
                        <b>@Formato.Corto(d.Hallazgo?.Descripcion)</b>
                        <span>@(aprobada ? "Aprobó" : "Descartó") recomendación · @d.RevisadoPor?.Nombre (@d.RevisadoPor?.Rol?.Nombre)</span>
                        @if (!string.IsNullOrWhiteSpace(d.Comentario))
                        {
                            <span>Comentario: @d.Comentario</span>
                        }
                    </div>
                    <div class="evento-fecha">@d.FechaRevision?.ToString("dd/MM/yyyy")</div>
                </div>
            }
        </div>
    }
</div>
