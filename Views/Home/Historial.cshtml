@{
    ViewData["Title"] = "Historial y Seguimiento";
    ViewData["HeaderTitle"] = "Historial y Seguimiento de Auditorías";
}

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Buscar proceso o hallazgo...">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select">
                    <option selected>Todas las Empresas</option>
                    <option value="1">DIDELCO</option>
                    <option value="2">COPRO</option>
                    <option value="3">Invercalma</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select">
                    <option selected>Estado Actual</option>
                    <option value="1">En Progreso</option>
                    <option value="2">Pendiente</option>
                    <option value="3">Solventado</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100"><i class="bi bi-funnel-fill me-1"></i>Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-custom align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="px-4 py-3">ID Req.</th>
                        <th class="py-3">Fecha</th>
                        <th class="py-3">Empresa / Proceso</th>
                        <th class="py-3">Riesgo</th>
                        <th class="py-3">Estado Plan de Acción</th>
                        <th class="py-3 text-end px-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="px-4 py-3 text-muted">#AUD-1042</td>
                        <td>28 Oct 2026</td>
                        <td>
                            <div class="fw-bold text-dark">DIDELCO</div>
                            <div class="small text-muted">Registro Compras (Inventario)</div>
                        </td>
                        <td><span class="badge bg-warning text-dark">Moderado</span></td>
                        <td><span class="badge bg-info text-dark">En Progreso (75%)</span></td>
                        <td class="text-end px-4 action-buttons">
                            <button class="btn btn-outline-primary"><i class="bi bi-eye"></i></button>
                            <button class="btn btn-outline-secondary"><i class="bi bi-download"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>