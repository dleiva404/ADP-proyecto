@model SmartProcessAI.ViewModels.PanelViewModel
@using SmartProcessAI.ViewModels
@{
    ViewData["Title"] = "Panel de auditoría";
    ViewData["Activo"] = "panel";
}

<div class="cabecera">
    <div>
        <h1>Panel de auditoría</h1>
        <p>Resumen del estado de la auditoría en Inversiones Calma</p>
    </div>
    @if (User.IsInRole("Auditor"))
    {
        <a class="boton boton-rojo" asp-controller="Home" asp-action="CargarDatos">Registrar tarea</a>
    }
</div>

<div class="metricas">
    <div class="tarjeta"><div class="etiqueta">Auditorías</div><div class="metrica-num">@Model.Auditorias</div></div>
    <div class="tarjeta tarjeta-oscura"><div class="etiqueta">Hallazgos abiertos</div><div class="metrica-num num-dorado">@Model.Abiertos</div></div>
    <div class="tarjeta"><div class="etiqueta">Críticos</div><div class="metrica-num num-rojo">@Model.Criticos</div></div>
    <div class="tarjeta"><div class="etiqueta">Por revisar</div><div class="metrica-num">@Model.PorRevisar</div></div>
</div>

<div class="tarjeta">
    <h2>Hallazgos por nivel de riesgo</h2>
    <div class="riesgos">
        @foreach (var r in new[] { ("bajo", "Bajo", Model.Bajo), ("medio", "Medio", Model.Medio), ("alto", "Alto", Model.Alto), ("critico", "Crítico", Model.Critico) })
        {
            <div>
                <div class="riesgo-barra tag-@r.Item1"></div>
                <div class="riesgo-dato tag-@(r.Item1)-p">@r.Item2<b>@r.Item3</b></div>
            </div>
        }
    </div>
</div>

<div class="tarjeta">
    <div class="titulo-con-enlace">
        <h2>Hallazgos recientes</h2>
        <a class="enlace-rojo" asp-controller="Home" asp-action="Hallazgos">Ver todos →</a>
    </div>
    <table class="tabla">
        <thead><tr><th>Hallazgo</th><th>Proceso</th><th>Riesgo</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var h in Model.Recientes)
            {
                <tr>
                    <td class="fuerte">@Formato.Corto(h.Descripcion)</td>
                    <td>@h.Tarea?.Proceso?.Nombre</td>
                    <td><span class="tag tag-@Formato.ClaseRiesgo(h.Riesgo)">@Formato.TextoRiesgo(h.Riesgo)</span></td>
                    <td><span class="estado estado-@Formato.ClaseEstado(h.Estado)">@h.Estado</span></td>
                    <td class="derecha"><a class="enlace-rojo" asp-controller="Home" asp-action="Hallazgos" asp-route-id="@h.Id">Revisar →</a></td>
                </tr>
            }
            @if (Model.Recientes.Count == 0)
            {
                <tr><td colspan="5">Aún no hay hallazgos. Registra una tarea para empezar.</td></tr>
            }
        </tbody>
    </table>
</div>
