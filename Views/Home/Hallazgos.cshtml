@model SmartProcessAI.ViewModels.HallazgosViewModel
@using SmartProcessAI.ViewModels
@{
    ViewData["Title"] = "Revisión de hallazgos";
    ViewData["Activo"] = "hallazgos";
    var s = Model.Seleccionado;
    var reco = s?.Recomendaciones.FirstOrDefault();
    bool puedeDecidir = User.IsInRole("Jefatura");
}

<div class="cabecera">
    <div>
        <h1>Revisión de hallazgos</h1>
        <p>Revisa las recomendaciones de la IA y decide qué hacer con cada una</p>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-info">@aviso</div>
}

@if (s == null)
{
    <div class="tarjeta">Aún no hay hallazgos. Registra una tarea para que la IA la analice.</div>
}
else
{
    <div class="revision">
        <div class="tarjeta lista-hallazgos">
            @foreach (var h in Model.Lista)
            {
                <a class="hallazgo-fila@(h.Id == s.Id ? " activa" : "")" asp-controller="Home" asp-action="Hallazgos" asp-route-id="@h.Id">
                    <div>
                        <b>@Formato.Corto(h.Descripcion, 45)</b>
                        <small>@h.Tarea?.Proceso?.Nombre</small>
                        <span class="estado estado-@Formato.ClaseEstado(h.Estado)">@h.Estado</span>
                    </div>
                    <span class="tag tag-@Formato.ClaseRiesgo(h.Riesgo)">@Formato.TextoRiesgo(h.Riesgo)</span>
                </a>
            }
        </div>

        <div class="tarjeta">
            <h3 class="detalle-titulo">@Formato.Corto(s.Descripcion, 80)</h3>
            <span class="tag tag-@Formato.ClaseRiesgo(s.Riesgo)">@Formato.TextoRiesgo(s.Riesgo)</span>
            <div class="detalle-proceso" style="margin-top:12px">Proceso: @s.Tarea?.Proceso?.Nombre</div>

            <div class="etiqueta"><span class="etiqueta-ia">IA</span>Recomendación</div>
            @if (reco != null)
            {
                <p class="detalle-reco">@reco.Descripcion</p>
                <p class="detalle-proceso">Tiempo ahorrado estimado: @reco.TiempoAhorradoMin min al mes</p>
            }

            @if (s.Estado == "Pendiente" && puedeDecidir)
            {
                <form method="post" asp-controller="Home" asp-action="Decidir">
                    <input type="hidden" name="id" value="@s.Id" />
                    <div class="formulario">
                        <label>Comentario</label>
                        <textarea class="form-control" name="comentario" placeholder="Obligatorio si se descarta"></textarea>
                    </div>
                    <div class="detalle-botones">
                        <button type="submit" name="decision" value="aprobar" class="boton boton-verde">Aprobar</button>
                        <button type="submit" name="decision" value="descartar" class="boton boton-borde-rojo">Descartar</button>
                    </div>
                </form>
            }
            else if (s.Estado != "Pendiente")
            {
                <div class="detalle-proceso">Estado: <b>@s.Estado</b>@(string.IsNullOrWhiteSpace(reco?.Comentario) ? "" : " · " + reco!.Comentario)</div>
            }
            else
            {
                <div class="detalle-proceso">Tu rol no puede aprobar ni descartar hallazgos.</div>
            }
        </div>
    </div>
}
