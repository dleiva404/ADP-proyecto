<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartProcess AI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #F4F7FA;
            color: #1F2933;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    
        .sidebar {
            min-height: 100vh;
            background-color: #153D63;
            color: white;
            padding-top: 20px;
        }
    
        .sidebar .brand {
            font-size: 1.2rem;
            font-weight: bold;
            padding: 10px 20px;
            margin-bottom: 20px;
            color: #fff;
        }
    
        .sidebar a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            padding: 12px 20px;
            display: block;
            transition: 0.3s;
        }
    
        .sidebar a:hover,
        .sidebar a.active {
            background-color: #2E6FA7;
            color: white;
            border-left: 4px solid #1B7F72;
        }
    
        .topbar {
            background-color: white;
            border-bottom: 1px solid #D5DEE7;
            padding: 15px 25px;
        }
    
        /* Botones principales y enlaces */
        .btn-primary {
            background-color: #153D63;
            border-color: #153D63;
            color: #ffffff;
        }
    
        .btn-primary:hover {
            background-color: #2E6FA7;
            border-color: #2E6FA7;
        }
    
        .btn-ia {
            background-color: #1B7F72;
            border-color: #1B7F72;
            color: #ffffff;
        }
    
        .btn-ia:hover {
            background-color: #146157;
            color: #ffffff;
        }
    
        /* Tarjetas y contenedores */
        .card {
            border: 1px solid #D5DEE7;
            border-radius: 8px;
        }
    
        .card-metric {
            border-left: 4px solid #153D63;
        }
    
        .card-metric-ia {
            border-left: 4px solid #1B7F72;
        }
    
        .card-metric-critico {
            border-left: 4px solid #B3261E;
        }
    
        /* Componentes de IA y Carga */
        .ai-recommendation {
            background-color: rgba(27, 127, 114, 0.08);
            border-left: 4px solid #1B7F72;
            border-radius: 0.375rem;
        }
    
        .text-ia {
            color: #1B7F72 !important;
        }
    
        .drop-zone {
            border: 2px dashed #2E6FA7;
            border-radius: 8px;
            padding: 35px;
            text-align: center;
            background-color: #F4F7FA;
            cursor: pointer;
        }
    
        /* Colores de Riesgo Oficiales */
        .badge-bajo {
            background-color: #2E7D4F;
            color: #ffffff;
        }
    
        .badge-medio {
            background-color: #F2B705;
            color: #1F2933;
        }
    
        .badge-alto {
            background-color: #C2570C;
            color: #ffffff;
        }
    
        .badge-critico {
            background-color: #B3261E;
            color: #ffffff;
        }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Menú Fijo -->
        <div class="col-md-2 sidebar d-none d-md-block px-0">
            <div class="brand"><i class="bi bi-cpu-fill me-2"></i>SmartProcess AI</div>
            <a asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill me-2"></i> Dashboard</a>
            <a asp-controller="Home" asp-action="CargarDatos"><i class="bi bi-cloud-arrow-up-fill me-2"></i> Cargar Datos</a>
            <a asp-controller="Home" asp-action="Hallazgos"><i class="bi bi-search me-2"></i> Ver Hallazgos</a>
            <a asp-controller="Home" asp-action="Historial"><i class="bi bi-clock-history me-2"></i> Historial</a>
        </div>

        <!-- Contenedor Principal -->
        <div class="col-md-10 px-0">
            <!-- Topbar Fija -->
            <div class="topbar d-flex justify-content-between align-items-center mb-4">
                <h4 class="m-0 text-dark">@ViewData["HeaderTitle"]</h4>
                <div class="user-profile d-flex align-items-center">
                    <i class="bi bi-bell-fill text-muted me-4 fs-5"></i>
                    <div class="text-end me-3">
                        <p class="m-0 fw-bold fs-6">Auditor Operativo</p>
                        <small class="text-muted">Grupo Calma</small>
                    </div>
                    <img src="https://ui-avatars.com/api/?name=Auditor+Operativo&background=0d6efd&color=fff" class="rounded-circle" width="40" alt="Perfil">
                </div>
            </div>

            <!-- Contenido Dinámico de cada Vista -->
            <main role="main" class="container px-4 pb-5">
                @RenderBody()
            </main>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>